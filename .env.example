# Copy this file to .env and fill in your keys. .env is gitignored — never
# commit real keys.

# Required for sound-design (ElevenLabs SFX + music generation).
# Get a key at https://elevenlabs.io → Profile → API Keys.
ELEVENLABS_API_KEY=

# Optional: enables video-qa's deeper vision layer (L3). QA still runs its
# other layers without it.
GEMINI_API_KEY=

# Note: here.now canvas delivery does NOT use this file — its credentials live
# in ~/.herenow/credentials (see the here-now skill / https://here.now/docs).

# Optional — arcads-broll: AI-generated B-roll and motion graphics (arcads.ai)
ARCADS_API_KEY=

# Optional — where per-project working folders live (absolute path). Default: outputs/ in this
# pack. Set it when the videos live in another repo; MASTER_CONTEXT.md should say the same.
VIDEO_PROJECTS_DIR=

# Optional — cloud Whisper fallback for the video-qa engine (tools/video-qa), hook-splitter's
# transcribe.py and arcads-video-edit's per-shot transcripts. Local whisper.cpp is the default.
OPENAI_API_KEY=

# Optional — arcads-video-edit's generated clips (scripts/arcads_gen.py): your workspace ids,
# and ARCADS_ENV_FILE if the Arcads credential lives in a different .env.
ARCADS_PRODUCT_ID=
ARCADS_PROJECT_ID=
ARCADS_ENV_FILE=

# Optional — override tool locations when they are not on PATH.
# FFMPEG= FFPROBE= WHISPER_CLI= WHISPER_MODEL= VAD_BIN= VAD_MODEL= VIDEO_QA_CACHE_DIR=
